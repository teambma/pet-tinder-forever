# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit it.

# Postgres connection string (Render dev database locally, Render's managed DB in prod)
DATABASE_URL=postgresql://user:password@host:5432/database

# 32+ char random string — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the app. Dev: http://localhost:5173  |  Prod: https://<your-app>.onrender.com
BETTER_AUTH_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Port the Express server listens on. Render provides this in production.
PORT=3000
